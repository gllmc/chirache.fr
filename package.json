{
    "dependencies": {
        "@tailwindcss/cli": "^4.3.5",
        "@tailwindcss/typography": "^0.5.4",
        "tailwindcss": "^4.3.5"
    },
    "scripts": {
        "build": "npx @tailwindcss/cli -i ./theme/input.css -o ./static/css/tailwind-output.css --minify && zola build",
        "watch": "concurrently 'npx @tailwindcss/cli -i ./theme/input.css -o ./static/css/tailwind-output.css --watch' 'zola serve'"
    },
    "devDependencies": {
        "concurrently": "^10.0.7",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.1": true
    }
}
